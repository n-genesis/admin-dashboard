nav#header-nav.navbar.navbar-expand-lg.bg-body-tertiary.border-bottom.border-start(aria-label="Main Navigation")
  .container-fluid
    // Mobile navbar collapes toggle
    button#sidebarToggle.btn.btn-secondary.me-2
      i.bi.bi-grid
    a.navbar-brand.d-sm-none.me-auto(href="#") N-Gen Admin
    button.navbar-toggler(
      aria-label="Toggle navigation" 
      aria-expanded="false" 
      aria-controls="navbar-content" 
      data-bs-target="#navbar-content" 
      data-bs-toggle="collapse" 
      type="button"
      )
      span.navbar-toggler-icon

    // Nabar Items
    #navbar-content.collapse.navbar-collapse
      ul.navbar-nav.ms-auto.mt-2.mt-lg-0
        li.nav-item.active
          a.nav-link(href="!#") Home
        li.nav-item
          a.nav-link(href="#") Link
        li.nav-item.dropdown
          a#navbarDropdown.nav-link.dropdown-toggle(
            href="#" 
            role="button" 
            data-bs-toggle="dropdown" 
            aria-haspopup="true" 
            aria-expanded="false"
          ) Dropdown

          // Dropdown
          .dropdown-menu.dropdown-menu-end(aria-labelledby="dropdownUser")
            h6.dropdown-header
              .dropdown-user-details
                .dropdown-user-details-name
                  b @username
                .dropdown-user-details-email no-reply@email.com
            .dropdown-divider
            a.dropdown-item(href="#") Settings
            a.dropdown-item(href="#") Activity Log
            .dropdown-divider
            a.dropdown-item(href="#") Logout
