extends ../layouts/dashboard.pug

block config
    - var pageTitle = 'Images';
    - var index = false;
    - var current_page = 'images';

prepend css

block content

    // page header
    include includes/page-header.pug

    // Images
    .row
        .col-sm-12.col-lg-6.col-md-6
            .card
                .card-header.d-flex.justify-content-between
                    .header-title
                        h4.mb-0.fw-lighter.flex-grow-1 Responsive images
                .card-body
                    p
                        | Images in Bootstrap are made responsive with 
                        code .img-fluid
                        | . 
                        code max-width: 100%;
                        |                     and 
                        code height: auto;
                        |  are applied to the image so that it scales with the parent element.
                    img.img-fluid.rounded(src='../assets/images/bots/yGA-HhpU.jpg' alt='Responsive image')
        .col-sm-12.col-lg-6.col-md-6
            .card.mb-3
                .card-header.d-flex.justify-content-between
                    .header-title
                        h4.mb-0.fw-lighter.flex-grow-1 Image thumbnails
                .card-body
                    p
                        | In addition to our 
                        a(href='/docs/4.3/utilities/borders/') border-radius utilities
                        | , you can use
                        code .img-thumbnail
                        |  to give an image a rounded 1px border appearance.
                    ul.list-unstyled.p-0.m-0.row
                        li.col-lg-4.col-md-6.col-sm-6.mt-2
                            img.img-thumbnail.w-100.img-fluid.rounded(src='../assets/images/bots/uTUnnVOh.jpg' alt='Responsive image')
                        li.col-lg-4.col-md-6.col-sm-6.mt-2
                            img.rounded.w-100.img-fluid.rounded(src='../assets/images/bots/UuVrZ-6E.jpg' alt='Responsive image')
                        li.col-lg-4.col-md-6.col-sm-6.mt-2
                            img.rounded.w-100.img-fluid.rounded(src='../assets/images/bots/dKQvESTJ.jpg' alt='Responsive image')
            .card
                .card-header.d-flex.justify-content-between
                    .header-title
                        h4.mb-0.fw-lighter.flex-grow-1 Image thumbnails
                .card-body
                    p
                        | In addition to our 
                        a(href='/docs/4.3/utilities/borders/') border-radius utilities
                        | , you can use
                        code .img-thumbnail
                        |  to give an image a rounded 1px border appearance.
                    img.mt-2.img-thumbnail.rounded.float-start(src='../assets/images/bots/VcCxd6y9x200.jpg' alt='Responsive image')
                    img.mt-2.img-thumbnail.rounded.float-end(src='../assets/images/bots/zN7oNgsZx200.jpg' alt='Responsive image')



append scripts

