section
  .row
    .col-xl-12
      .card
        .card-header.d-flex.justify-content-between.align-items-center

          i.bi.bi-table.me-2
          h4.mb-0.fw-lighter.flex-grow-1 DataTable Example
          button.btn.btn-outline-success.me-2(data-bsnippet="btn-view", type="button", role="button")
            i.bi.bi-eye
          button.btn.btn-outline-primary.me-2(data-bsnippet="btn-bookmark", type="button", role="button")
            i.bi.bi-bookmark
          button.btn.btn-outline-danger.me-2(data-bsnippet="btn-delete", type="button", role="button")
            i.bi.bi-trash

        .card-body.table-responsive
          table.table
            thead
              tr
                th(scope="col") #
                th(scope="col") First
                th(scope="col") Last
                th(scope="col") Handle
            tbody
              tr
                th(scope="row") 1
                td Mark
                td Otto
                td @mdo
              tr
                th(scope="row") 2
                td Jacob
                td Thornton
                td @fat
              tr
                th(scope="row") 3
                td(colspan="2") Larry the Bird
                td @twitter
        
        .card-footer.d-flex.flex-column.flex-md-row.justify-content-between.align-items-center.gap-3
          .text-muted
            | Showing 
            strong 1 to 10 
            | of 
            strong 57 

            | entries
          
          .card-footer-btn-group.d-flex.flex-wrap.gap-2
            // Export Data Action
            button.btn.btn-outline-secondary(type="button", title="Export Table")
              i.bi.bi-download
              |  Export
            
            // Column Visibility Toggle Settings
            button.btn.btn-outline-secondary(type="button", title="Filter Columns")
              i.bi.bi-sliders

              |  Columns
            
            // Primary Creation Action
            button.btn.btn-primary(type="button")
              i.bi.bi-plus-lg
              |  Add New Record


