.row.align-items-center
  .col-lg-4.col-sm-6
    // Search
    .search-box.mb-2.me-2
      .position-relative
        .input-group.mb-3
          button#button-addon1.btn.btn-outline-secondary(type='button')
            i.bi.bi-search
          input.form-control(type='text' placeholder='Search for something' aria-label='Example text with button addon' aria-describedby='button-addon1')
    // /.search-box
  .col-lg-8.col-sm-6
    .d-flex.flex-wrap.align-items-center.justify-content-center.justify-content-lg-end.mb-3
      .dropdown
        button.btn.btn-primary.dropdown-toggle(type='button' data-bs-toggle='dropdown' aria-haspopup='true' aria-expanded='false')
          i.bi.bi-plus-lg.me-1
          |  Create New
        .dropdown-menu.dropdown-menu-end
          a.dropdown-item(href='#')
            i.bi.bi-folder.me-1
            |  Folder
          a.dropdown-item(href='#')
            i.bi.bi-file-earmark.me-1
            |  File
      // /.dropwdown
