section
    // Statistics Cards
    .row.mb-4
        // Sales Card
        .col-12.col-md-6.col-lg-3.mb-3.mb-lg-0
            .card.shadow-sm.h-100
                .card-body
                    .d-flex.align-items-center.justify-content-between.mb-3
                        .d-flex.align-items-center.justify-content-center.rounded-3.bg-primary.bg-opacity-10.text-primary.d-inline-block.h-25.w-25
                            i.bi.bi-cart2.fs-3.me-1.py-2.px-3
                        span.badge.bg-success
                            i.bi.bi-arrow-up.me-1
                            | 12.5%
                    h6.text-muted.mb-2 Total Sales
                    h4.mb-3 $24,589
                    .progress
                        .progress-bar.bg-primary(style="width: 75%")

        // Users Card
        .col-12.col-md-6.col-lg-3.mb-3.mb-lg-0
            .card.shadow-sm.h-100
                .card-body
                    .d-flex.align-items-center.justify-content-between.mb-3
                        .d-flex.align-items-center.justify-content-center.rounded-3.bg-success.bg-opacity-10.text-success.d-inline-block.h-25.w-25
                            i.bi.bi-person.fs-3.me-1.py-2.px-3
                        span.badge.bg-danger
                            i.bi.bi-arrow-down.me-1
                            | 5.2%
                    h6.text-muted.mb-2 Active Users
                    h4.mb-3 14,789
                    .progress
                        .progress-bar.bg-success(style="width: 65%")

        // Orders Card
        .col-12.col-md-6.col-lg-3.mb-3.mb-lg-0
            .card.shadow-sm.h-100
                .card-body
                    .d-flex.align-items-center.justify-content-between.mb-3
                        .d-flex.align-items-center.justify-content-center.rounded-3.bg-warning.bg-opacity-10.text-warning.d-inline-block.h-25.w-25
                            i.bi.bi-box.fs-3.me-1.py-2.px-3
                        span.badge.bg-success
                            i.bi.bi-arrow-up.me-1

                            | 8.4%
                    h6.text-muted.mb-2 New Orders
                    h4.mb-3 1,589
                    .progress
                        .progress-bar.bg-warning(style="width: 85%")

        // Revenue Card
        .col-12.col-md-6.col-lg-3.mb-3.mb-lg-0
            .card.shadow-sm
                .card-body
                    .d-flex.align-items-center.justify-content-between.mb-3
                        .d-flex.align-items-center.justify-content-center.rounded-3.bg-info.bg-opacity-10.text-info.d-inline-block.h-25.w-25
                            i.bi.bi-cash-stack.fs-3.me-1.py-2.px-3
                        span.badge.bg-success
                            i.bi.bi-arrow-up.me-1
                            | 15.7%
                    h6.text-muted.mb-2 Revenue
                    h4.mb-3 $45,289
                    .progress
                        .progress-bar.bg-info(style="width: 90%")