.row
    .col-xl-6
        .card.mb-4
            .card-header.d-flex.justify-content-between.align-items-center
                i.bi.bi-graph-up.me-2
                h4.mb-0.fw-lighter.flex-grow-1 Recent Activity
                .card-header-btn-group
                    button.btn.btn-outline-primary.me-2(data-bsnippet="btn-bookmark", type="button", role="button")
                        i.bi.bi-bookmark
                    button.btn.btn-outline-danger.me-2(data-bsnippet="btn-delete", type="button", role="button")
                        i.bi.bi-trash
            .card-body
                canvas#myAreaChart(width='100%', height='40')

    .col-xl-6
        .card.mb-4
            .card-header.d-flex.justify-content-between.align-items-center
                i.bi.bi-bar-chart-fill.me-2
                h4.mb-0.fw-lighter.flex-grow-1 Bar Chart Example
                .card-header-btn-group
                    button.btn.btn-outline-primary.me-2(data-bsnippet="btn-bookmark", type="button", role="button")
                        i.bi.bi-bookmark
                    button.btn.btn-outline-danger.me-2(data-bsnippet="btn-delete", type="button", role="button")
                        i.bi.bi-trash
            .card-body
                canvas#myBarChart(width='100%', height='40')
