extends ../layouts/dashboard.pug

block config
    - var pageTitle = 'Forms';
    - var index = false;
    - var current_page = 'forms';

prepend css

block content

    // page header
    include includes/page-header.pug

    // Form Control Examples
    .row.gy-3
        .col-12
            // Card Examples
            article.card
                header.card-header
                    h4.mb-0.fw-lighter.flex-grow-1 Form controls
                .card-body
                    p
                        | Form controls are styled with a mix of Sass and CSS variables, allowing them to adapt to color modes
                        | and support any customization method.
                    .row
                        .col-lg-6
                            .bs-component
                                form
                                    fieldset
                                        legend Legend
                                        .row
                                            label.col-sm-2.col-form-label(for='staticEmail') Email
                                            .col-sm-10
                                                input#staticEmail.form-control-plaintext(type='text' readonly='' value='email@example.com')
                                        div
                                            label.form-label.mt-4(for='exampleInputEmail1') Email address
                                            input#exampleInputEmail1.form-control(type='email' aria-describedby='emailHelp' placeholder='Enter email')
                                            small#emailHelp.form-text.text-muted
                                                | We&apos;ll never share your email
                                                | with anyone else.
                                        div
                                            label.form-label.mt-4(for='exampleInputPassword1') Password
                                            input#exampleInputPassword1.form-control(type='password' placeholder='Password' autocomplete='off')
                                        div
                                            label.form-label.mt-4(for='exampleSelect1') Example select
                                            select#exampleSelect1.form-select
                                                option 1
                                                option 2
                                                option 3
                                                option 4
                                                option 5
                                        div
                                            label.form-label.mt-4(for='exampleSelect1')
                                                | Example disabled
                                                | select
                                            select#exampleDisabledSelect1.form-select(disabled='')
                                                option 1
                                                option 2
                                                option 3
                                                option 4
                                                option 5
                                        div
                                            label.form-label.mt-4(for='exampleSelect2')
                                                | Example multiple
                                                | select
                                            select#exampleSelect2.form-select(multiple='')
                                                option 1
                                                option 2
                                                option 3
                                                option 4
                                                option 5
                                        div
                                            label.form-label.mt-4(for='exampleTextarea') Example textarea
                                            textarea#exampleTextarea.form-control(rows='3')
                                        div
                                            label.form-label.mt-4(for='formFile') Default file input example
                                            input#formFile.form-control(type='file')
                                        fieldset
                                            legend.mt-4 Radio buttons
                                            .form-check
                                                input#optionsRadios1.form-check-input(type='radio' name='optionsRadios' value='option1' checked='')
                                                label.form-check-label(for='optionsRadios1')
                                                    | Option one is this and that&mdash;be sure to include why it&apos;s great
                                            .form-check
                                                input#optionsRadios2.form-check-input(type='radio' name='optionsRadios' value='option2')
                                                label.form-check-label(for='optionsRadios2')
                                                    | Option two can be something else and selecting it will deselect option
                                                    | one
                                            .form-check.disabled
                                                input#optionsRadios3.form-check-input(type='radio' name='optionsRadios' value='option3' disabled='')
                                                label.form-check-label(for='optionsRadios3')
                                                    | Option three is disabled
                                        fieldset
                                            legend.mt-4 Checkboxes
                                            .form-check
                                                input#flexCheckDefault.form-check-input(type='checkbox' value='')
                                                label.form-check-label(for='flexCheckDefault')
                                                    | Default checkbox
                                            .form-check
                                                input#flexCheckChecked.form-check-input(type='checkbox' value='' checked='')
                                                label.form-check-label(for='flexCheckChecked')
                                                    | Checked checkbox
                                        fieldset
                                            legend.mt-4 Switches
                                            .form-check.form-switch
                                                input#flexSwitchCheckDefault.form-check-input(type='checkbox')
                                                label.form-check-label(for='flexSwitchCheckDefault')
                                                    | Default switch
                                                    | checkbox input
                                            .form-check.form-switch
                                                input#flexSwitchCheckChecked.form-check-input(type='checkbox' checked='')
                                                label.form-check-label(for='flexSwitchCheckChecked')
                                                    | Checked switch
                                                    | checkbox input
                                        fieldset
                                            legend.mt-4 Ranges
                                            label.form-label(for='customRange1') Example range
                                            input#customRange1.form-range(type='range')
                                            label.form-label(for='disabledRange') Disabled range
                                            input#disabledRange.form-range(type='range' disabled='')
                                            label.form-label(for='customRange3') Example range
                                            input#customRange3.form-range(type='range' min='0' max='5' step='0.5')
                                        button.btn.btn-primary(type='submit') Submit
                        .col-lg-4.offset-lg-1
                            form.bs-component
                                div
                                    fieldset(disabled='')
                                        label.form-label(for='disabledInput') Disabled input
                                        input#disabledInput.form-control(type='text' placeholder='Disabled input here...' disabled='')
                                div
                                    fieldset
                                        label.form-label.mt-4(for='readOnlyInput') Readonly input
                                        input#readOnlyInput.form-control(type='text' placeholder='Readonly input here...' readonly='')
                                .has-success
                                    label.form-label.mt-4(for='inputValid') Valid input
                                    input#inputValid.form-control.is-valid(type='text' value='correct value')
                                    .valid-feedback Success! You&apos;ve done it.
                                .has-danger
                                    label.form-label.mt-4(for='inputInvalid') Invalid input
                                    input#inputInvalid.form-control.is-invalid(type='text' value='wrong value')
                                    .invalid-feedback Sorry, that username&apos;s taken. Try another?
                                div
                                    label.col-form-label.col-form-label-lg.mt-4(for='inputLarge')
                                        | Large
                                        | input
                                    input#inputLarge.form-control.form-control-lg(type='text' placeholder='.form-control-lg')
                                div
                                    label.col-form-label.mt-4(for='inputDefault') Default input
                                    input#inputDefault.form-control(type='text' placeholder='Default input')
                                div
                                    label.col-form-label.col-form-label-sm.mt-4(for='inputSmall')
                                        | Small
                                        | input
                                    input#inputSmall.form-control.form-control-sm(type='text' placeholder='.form-control-sm')
                                div
                                    label.form-label.mt-4 Input addons
                                    div
                                        .input-group.mb-3
                                            span.input-group-text $
                                            input.form-control(type='text' aria-label='Amount (to the nearest dollar)')
                                            span.input-group-text .00
                                        .input-group.mb-3
                                            input.form-control(type='text' placeholder="Recipient's username" aria-label="Recipient's username" aria-describedby='button-addon2')
                                            button#button-addon2.btn.btn-primary(type='button') Button
                                div
                                    label.form-label.mt-4 Floating labels
                                    .form-floating.mb-3
                                        input#floatingInput.form-control(type='email' placeholder='name@example.com')
                                        label(for='floatingInput') Email address
                                    .form-floating
                                        input#floatingPassword.form-control(type='password' placeholder='Password' autocomplete='off')
                                        label(for='floatingPassword') Password


append scripts

