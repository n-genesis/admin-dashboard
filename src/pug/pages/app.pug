doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title AppName Landing Page
    //- Favicon
    link(rel='icon', type='image/x-icon', href='assets/favicon.ico')
    //- Bootstrap 5 CSS CDN
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5/dist/css/bootstrap.min.css")
    //- Bootstrap Icons CDN (Optional but recommended for icons)
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css")

  body.bg-light
    //- Navigation Bar
    nav.navbar.navbar-expand-lg.navbar-dark.bg-dark.sticky-top
      .container
        a.navbar-brand.fw-bold(href="#") 
          i.bi.bi-lightning-charge-fill.text-warning.me-2
          | AppName
        button.navbar-toggler(type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation")
          span.navbar-toggler-icon
        .collapse.navbar-collapse#navbarNav
          ul.navbar-nav.ms-auto
            li.nav-item: a.nav-link.active(href="#") Home
            li.nav-item: a.nav-link(href="#features") Features
            li.nav-item: a.nav-link(href="#pricing") Pricing
            li.nav-item: a.btn.btn-warning.ms-lg-3.mt-2.mt-lg-0.text-dark.fw-semibold(href="#contact") Get Started

    //- Hero Section
    header.bg-dark.text-white.py-5.position-relative.border-bottom.border-secondary
      .container.py-5
        .row.align-items-center.g-5
          .col-lg-6.text-center.text-lg-start
            h1.display-4.fw-bold.lh-sm.mb-3 Build Fast & Clean With Modern Tech Stacks
            p.lead.text-secondary.mb-4 Easily parse templates, leverage raw CSS flexibility, and deliver ultra-responsive layouts using the power of Bootstrap 5 grid systems.
            .d-grid.gap-3.d-sm-flex.justify-content-sm-center.justify-content-lg-start
              a.btn.btn-warning.btn-lg.px-4.me-sm-3(href="#") Start Free Trial
              a.btn.btn-outline-light.btn-lg.px-4(href="#") Learn More
          .col-lg-6.text-center
            //- Mockup placeholder image using Bootstrap styling
            img.img-fluid.rounded-3.shadow-lg(src="https://img.magnific.com/free-photo/3d-graph-computer-illustration_23-2151884868.jpg" alt="Dashboard Mockup" style="max-height: 400px; object-fit: cover;")

    //- Features Grid Section
    section#features.py-5
      .container.py-5
        .text-center.mb-5
          h2.fw-bold Core Platform Features
          p.text-muted.lead Everything you need to manage structural build workflows seamlessly.
        
        .row.g-4
          //- Feature 1
          .col-md-4
            .card.h-100.border-0.shadow-sm.text-center.p-4
              .card-body
                .bg-warning.bg-gradient.text-dark.rounded-circle.mx-auto.mb-4.d-flex.align-items-center.justify-content-center(style="width: 86px; height: 86px;")
                  i.bi.bi-speedometer2.fs-2
                h5.card-title.fw-bold Lightning Speed
                p.card-text.text-muted Pre-compiled asset processing ensures top tier production core file delivery directly to your root directories.
          
          //- Feature 2
          .col-md-4
            .card.h-100.border-0.shadow-sm.text-center.p-4
              .card-body
                .bg-dark.text-white.rounded-circle.mx-auto.mb-4.d-flex.align-items-center.justify-content-center(style="width: 86px; height: 86px;")
                  i.bi.bi-shield-check.fs-2
                h5.card-title.fw-bold Secure Delivery
                p.card-text.text-muted Advanced dependency protection ensures compiled source distribution files are sanitized and secure.
          
          //- Feature 3
          .col-md-4
            .card.h-100.border-0.shadow-sm.text-center.p-4
              .card-body
                .bg-warning.bg-gradient.text-dark.rounded-circle.mx-auto.mb-4.d-flex.align-items-center.justify-content-center(style="width: 86px; height: 86px;")
                  i.bi.bi-phone.fs-2
                h5.card-title.fw-bold Mobile Optimized
                p.card-text.text-muted Fluid mobile-first structures natively adapt cleanly to phones, tablets, and admin display hardware screens.

    //- Footer
    footer.bg-dark.text-secondary.py-4.mt-auto
      .container.text-center
        p.mb-2 &copy; 2026 AppName Inc. All rights reserved.
        .d-flex.justify-content-center.gap-3
          a.text-secondary(href="#") Privacy Policy
          span &middot;
          a.text-secondary(href="#") Terms of Service

    //- Bootstrap 5 Bundle JS with Popper CDN
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js")
